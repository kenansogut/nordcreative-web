        "message": "<Monogram> variant must be one of 'red' | 'ink' | 'paper' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute[name.name='frame'] > Literal[value!=/^(?:tile|circle|bare)$/]",
        "message": "<Monogram> frame must be one of 'tile' | 'circle' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|body|tone|divider|key|ref|className|style|children)$/]",
        "message": "<NumberedItem> doesn't accept that prop. Declared props: index, title, body, tone, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|inverse)$/]",
        "message": "<NumberedItem> tone must be one of 'primary' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|role|tone|size|accentLine|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, attribution, role, tone, size, accentLine."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|inverse)$/]",
        "message": "<PullQuote> tone must be one of 'primary' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|xl)$/]",
        "message": "<PullQuote> size must be one of 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|tone|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, tone."
