{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/editorial/**",
              "components/forms/**",
              "ui_kits/social/**",
              "ui_kits/stories/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Saldo|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Saldo, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper|outline|outlineInverse|accent)$/]",
        "message": "<Badge> tone must be one of 'ink' | 'paper' | 'outline' | 'outlineInverse' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|onDark|trailing|disabled|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, onDark, trailing, disabled, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|ink|paper|outline)$/]",
        "message": "<Button> variant must be one of 'accent' | 'ink' | 'paper' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|radius|bordered|elevated|accentRule|pad|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, surface, radius, bordered, elevated, accentRule, pad."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:white|paper|ink)$/]",
        "message": "<Card> surface must be one of 'white' | 'paper' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> radius must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|tone|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|inverse)$/]",
        "message": "<Checkbox> tone must be one of 'primary' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|bracketed|tone|rule|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, bracketed, tone, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|inverse|accent|muted)$/]",
        "message": "<Eyebrow> tone must be one of 'primary' | 'inverse' | 'accent' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|label|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, tone, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|ink|paper|outline|outlineInverse)$/]",
        "message": "<IconButton> tone must be one of 'accent' | 'ink' | 'paper' | 'outline' | 'outlineInverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|radius|treatment|caption|label|scrim|key|ref|className|style|children)$/]",
        "message": "<ImageFrame> doesn't accept that prop. Declared props: src, alt, ratio, radius, treatment, caption, label, scrim."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:none|md|lg|xl|pill)$/]",
        "message": "<ImageFrame> radius must be one of 'none' | 'md' | 'lg' | 'xl' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:mono|warm|none)$/]",
        "message": "<ImageFrame> treatment must be one of 'mono' | 'warm' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:none|soft|standard|strong)$/]",
        "message": "<ImageFrame> scrim must be one of 'none' | 'soft' | 'standard' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|tone|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, invalid, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|inverse)$/]",
        "message": "<Input> tone must be one of 'primary' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|assetBase|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|white|red|lockupRed|lockupInk)$/]",
        "message": "<Logo> variant must be one of 'ink' | 'white' | 'red' | 'lockupRed' | 'lockupInk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|frame|size|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: variant, frame, size."
      },
